# ──────────────────────────────────────────────────────────────
# ISSA — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy to .env.local (local dev) and set the same keys in Railway (production).
# Placeholders only — never commit real secrets to this file.
# ──────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# The pooled connection the app uses at runtime.
#
# ⚠️ If this points at a pooled endpoint (Neon's `-pooler` host, or PgBouncer),
# it MUST carry `pgbouncer=true` — without it Prisma prepares statements that a
# transaction-mode pooler cannot honour, and you get
# `prepared statement "s0" already exists` under concurrency. `connection_limit`
# caps the pool per PrismaClient; the app keeps one client per tenant schema, so
# keep this low or the connection count multiplies across academies.
#
# Neon example:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
# Local docker-compose (PgBouncer on 6432, transaction mode):
DATABASE_URL="postgresql://issa_admin:issa_dev_password_2024@localhost:6432/issa_platform?pgbouncer=true&connection_limit=10"

# Direct, NON-pooled connection. Used by the Prisma CLI for migrations and DDL,
# and by the job scheduler's advisory lock (which needs a real session — a
# session-scoped lock taken through a transaction pooler can leak).
# On Neon this is the same host WITHOUT `-pooler`.
DIRECT_DATABASE_URL="postgresql://issa_admin:issa_dev_password_2024@localhost:5432/issa_platform"

# Postgres password for docker-compose (local dev only).
POSTGRES_PASSWORD="issa_dev_password_2024"

# ─── Authentication ──────────────────────────────────────────
# JWT signing secrets. Separate secrets for access and refresh, so a leaked
# access token cannot be used to mint new ones.
# ⚠️ 32+ random characters each. The app refuses to start in production if these
# are short or left at the example values (see src/lib/auth/jwt.ts).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="issa-access-secret-change-me-in-production"
JWT_REFRESH_SECRET="issa-refresh-secret-change-me-in-production"

# Token lifetimes. Access is always short — it is what makes refresh-time
# revocation effective. "Remember me" extends only the refresh token.
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_REMEMBER_ME_EXPIRY="30d"

# ─── Rate Limiting ───────────────────────────────────────────
# Login attempts per window, keyed by client IP + phone number.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# ─── Background Jobs ─────────────────────────────────────────
# Cron jobs (subscription expiry, archiving, rolling session generation) run ONLY
# where this is exactly "true".
#
# ⚠️ Set it on ONE service. Every replica boots the same instrumentation hook, so
# leaving it on a web service with 2+ replicas runs every job once per replica —
# duplicate expiry, duplicate archiving, duplicate sessions. Unset means no jobs
# run at all, which is the safe default.
RUN_SCHEDULER="false"

# ─── Domains ─────────────────────────────────────────────────
# The base domain academies are served from — subdomains of it are academy slugs
# (aqua.issaacademies.com → slug "aqua"), used for theming and to scope login.
#
# Leave unset to fall back to "localhost", which makes aqua.localhost:3000 work in
# dev with no DNS. In production set it to your custom domain: Railway's
# *.up.railway.app cannot host per-academy subdomains, and while this is unset the
# subdomain feature silently does nothing.
NEXT_PUBLIC_ROOT_DOMAIN="localhost"

# ─── Application ─────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="ISSA Academies"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,ar"

# ─── Observability (planned — see Pre-Launch Hardening Plan §8) ──
# Sentry DSN for server + client error reporting. Until this is set there is no
# error monitoring at all: production failures are invisible.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# ─── Shared rate-limit store (planned — see §6) ──────────────
# The rate limiter currently keeps counters in process memory, so with N replicas
# the effective limit is N× and it resets on every deploy. Point this at Redis
# (Upstash works well with Railway) to make the limit global.
# REDIS_URL=""
